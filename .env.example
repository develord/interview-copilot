# API keys used by Interview Copilot.
#
# The desktop app does NOT read this file. Enter the keys in Réglages › Audio instead: they are
# stored in the Windows Credential Manager and only the Rust side reads them.
#
# These variables are read by the benchmark tools only (answer-bench, intent-bench, stt-bench),
# and override the keys saved in the app. Nothing loads this file automatically: set them in
# your shell, for example in PowerShell:
#   $env:ANTHROPIC_API_KEY = "..."
# Never commit a real key: .env and .env.* are git-ignored, except this example.

# Claude (Anthropic): question detection, answers, rolling summary and CV import.
# Used by answer-bench and intent-bench.
ANTHROPIC_API_KEY=

# Live transcription: one of the two is enough. Used by stt-bench.
# AssemblyAI is recommended (EU endpoint).
ASSEMBLYAI_API_KEY=
# Soniox needs a key from an EU-region project.
SONIOX_API_KEY=
